{
  "name": "wtrack-worker",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "dev": "wrangler dev",
    "backtest": "node --experimental-strip-types --env-file-if-exists=.dev.vars backtest/server.ts",
